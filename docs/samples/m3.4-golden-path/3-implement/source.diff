diff --git a/server/src/notifications/notifications.service.ts b/server/src/notifications/notifications.service.ts
index 917732f..4b84f95 100644
--- a/server/src/notifications/notifications.service.ts
+++ b/server/src/notifications/notifications.service.ts
@@ -9,8 +9,15 @@ import type { Notification, NotificationKind } from "./notification.types.js";
 export class NotificationsService {
   private readonly outbox: Notification[] = [];
 
-  notify(recipientId: string, kind: NotificationKind, enrollmentId: string, message: string): Notification {
-    const notification: Notification = { id: `ntf-${this.outbox.length + 1}`, recipientId, kind, message, enrollmentId };
+  notify(recipientId: string, kind: NotificationKind, enrollmentId: string, message: string, reason?: string): Notification {
+    const notification: Notification = {
+      id: `ntf-${this.outbox.length + 1}`,
+      recipientId,
+      kind,
+      message,
+      enrollmentId,
+      ...(reason ? { reason } : {}),
+    };
     this.outbox.push(notification);
     return notification;
   }
