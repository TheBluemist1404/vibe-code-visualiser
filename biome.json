{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/*/src/**/*.ts",
      "packages/*/test/**/*.ts",
      "apps/*/src/**/*.ts",
      "apps/*/test/**/*.ts",
      "apps/*/web/**/*.ts",
      "apps/*/web/**/*.tsx",
      "apps/*/e2e/**/*.ts",
      "examples/reference-app/acceptance/**/*.ts",
      "examples/reference-app/acceptance/**/*.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noImplicitAnyLet": "off",
        "noAssignInExpressions": "error",
        "useIterableCallbackReturn": "off"
      },
      "complexity": {
        "noCommaOperator": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/test/**", "apps/*/test/**", "apps/*/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
